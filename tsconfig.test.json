{
  // Type-checks the test suites (and, transitively, the source they import).
  // Run with `npm run test:types`; Vitest itself only transforms, not type-checks.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // The web app's ambient declarations are listed explicitly. `include` only
  // covers the test dirs, and a .d.ts that declares globals has to be IN the
  // program — being importable isn't enough. Without them, any test that
  // reaches the app shell fails to typecheck on `import.meta.env`, the `*.css`
  // side-effect imports, `__APP_VERSION__`, and the Google Identity globals.
  "include": [
    "metronome-engine/test",
    "presets/test",
    "web/test",
    "web/src/vite-env.d.ts",
    "web/src/cloud/google.d.ts"
  ]
}
